    <item>
      <title>Big Brother 1.6</title>
      <pubDate>Thu, 24 Sep 2026 16:29:22 +0100</pubDate>
      <sparkle:version>7</sparkle:version>
      <sparkle:shortVersionString>1.6</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>21</sparkle:minimumSystemVersion>
      <description><![CDATA[<pre>- A cog next to the version number, bottom right, opens a menu with "Check
  for updates". It checks straight away, skipping the 5 minute wait and any
  "Later", and tells you if you're already up to date.</pre>]]></description>
      <enclosure url="https://github.com/ijasonwhite/bigbrother-updates/releases/download/v1.6/BigBrother-1.6.apk" sparkle:edSignature="d2ujERoIhuzy8DpuVGCftrto8T/jCeJ44L+tIEM9GRoHaCksN5/bHTPoTEXUrA7P1f9naoIMJ7HmFtOL1p3hDg==" length="16836568" type="application/vnd.android.package-archive"/>
    </item>
    <item>
      <title>Big Brother 1.5</title>
      <pubDate>Thu, 24 Sep 2026 16:14:15 +0100</pubDate>
      <sparkle:version>6</sparkle:version>
      <sparkle:shortVersionString>1.5</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>21</sparkle:minimumSystemVersion>
      <description><![CDATA[<pre>- Looks for updates every 5 minutes instead of every half hour, so a new
  release turns up on screen within a few minutes.</pre>]]></description>
      <enclosure url="https://github.com/ijasonwhite/bigbrother-updates/releases/download/v1.5/BigBrother-1.5.apk" sparkle:edSignature="NxMtWGLb7LqqexkKqS8OuH3GTWlMXLsTAEV2kt8IJJTVkjVDveK7jpQnrmZdK4cVX5V2mQAuidsgqpUd6EoIDA==" length="16831674" type="application/vnd.android.package-archive"/>
    </item>
    <item>
      <title>Big Brother 1.4</title>
      <pubDate>Thu, 24 Sep 2026 16:11:27 +0100</pubDate>
      <sparkle:version>5</sparkle:version>
      <sparkle:shortVersionString>1.4</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>21</sparkle:minimumSystemVersion>
      <description><![CDATA[<pre>- A status banner across the top of the dashboard shows the whole fleet at a
  glance: "All systems normal" with a slow green pulse, or how many servers
  need attention with a quicker red one, plus online, alert and offline
  counts underneath.
- First release to arrive through the new every-half-hour update check.</pre>]]></description>
      <enclosure url="https://github.com/ijasonwhite/bigbrother-updates/releases/download/v1.4/BigBrother-1.4.apk" sparkle:edSignature="G55Hfb5YezBqrznU/vpWMfAq6Te4qFzWKpaq3Iqu90xlF2aFJH4F3BHXV1Fp/29nhpBzRhXRV9JvJveLIp9RBA==" length="16831667" type="application/vnd.android.package-archive"/>
    </item>
    <item>
      <title>Big Brother 1.3</title>
      <pubDate>Thu, 24 Sep 2026 16:02:55 +0100</pubDate>
      <sparkle:version>4</sparkle:version>
      <sparkle:shortVersionString>1.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>21</sparkle:minimumSystemVersion>
      <description><![CDATA[<pre>- Updates turn up much sooner. The app looks for one every half hour while
  it's open, instead of only when you open it and then not again for six
  hours, so a tablet left on the dashboard all day now finds them too.
- The pairing screen checks for updates as well.
- "Later" holds an update back for a day instead of until the next one.</pre>]]></description>
      <enclosure url="https://github.com/ijasonwhite/bigbrother-updates/releases/download/v1.3/BigBrother-1.3.apk" sparkle:edSignature="E+zZ2sw1qRo05z04GT3fwhTfCQD64lwYHqeztiM2MZaXqscGbVAwFFW5rI47hHy1QpB7wsUhmXl2xlt7p9OyBA==" length="16826960" type="application/vnd.android.package-archive"/>
    </item>
    <item>
      <title>Big Brother 1.2</title>
      <pubDate>Thu, 24 Sep 2026 15:58:13 +0100</pubDate>
      <sparkle:version>3</sparkle:version>
      <sparkle:shortVersionString>1.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>21</sparkle:minimumSystemVersion>
      <description><![CDATA[<pre>- The version number now shows at the bottom of the dashboard, so it's easy
  to tell which build a phone is running.</pre>]]></description>
      <enclosure url="https://github.com/ijasonwhite/bigbrother-updates/releases/download/v1.2/BigBrother-1.2.apk" sparkle:edSignature="Nj20Wn0I/GuVDq56WJ/6XpVUoifkP7qVvmYokMEjcs6HS8QmKmicIuvQgg2hDYoAA8zys6GPf3y4wrJUTjTgCA==" length="16826336" type="application/vnd.android.package-archive"/>
    </item>
    <item>
      <title>Big Brother 1.1</title>
      <pubDate>Thu, 24 Sep 2026 15:26:07 +0100</pubDate>
      <sparkle:version>2</sparkle:version>
      <sparkle:shortVersionString>1.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>21</sparkle:minimumSystemVersion>
      <description><![CDATA[<pre>- The app now updates itself. When a new version is out it offers to install
  it, and only installs a download whose signature checks out.</pre>]]></description>
      <enclosure url="https://github.com/ijasonwhite/bigbrother-updates/releases/download/v1.1/BigBrother-1.1.apk" sparkle:edSignature="qZOzP/8U/Frm5On/SCNpvAlqx7wPe5uJc4mjn8889sh5XeCHeusxsM7aGtREljbTWyrHSDgLbhN8YkFxcuw3BA==" length="16825754" type="application/vnd.android.package-archive"/>
